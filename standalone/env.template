# MAI Corrosion Control - standalone build (no Docker). Written by "mai.cmd setup".
# Change the main answers by running "mai.cmd setup" again; README-DEMO.md explains every line.
# Keep this file in UTF-8 (or plain ASCII).

# --- Database: Microsoft SQL Server 2016+. MAI_DATABASE_URL is written by "mai.cmd setup":
# mssql+pyodbc://…?driver=ODBC+Driver+18+for+SQL+Server through the installed ODBC driver, or
# mssql+pymssql://… without one. Tables in the schema MAI_DATABASE_SCHEMA (empty: the
# default schema of the login, usually dbo).
MAI_DATABASE_URL=
MAI_DATABASE_SCHEMA=

# --- Language model through LiteLLM (OpenAI-compatible .../v1/chat/completions)
MAI_LLM_API_URL=
MAI_LLM_API_KEY=
MAI_LLM_MODEL=
MAI_LLM_TIMEOUT_SECONDS=120
MAI_LLM_MAX_RETRIES=1
# Model that reads scanned pages and photos: it must accept images. Empty = scans are not read.
MAI_OCR_MODEL=
MAI_OCR_TIMEOUT_SECONDS=180
# Model that extracts fields from PDF and scans. Empty = MAI_LLM_MODEL.
MAI_DOCS_LLM_MODEL=

# --- Access: 0.0.0.0 = the dashboard opens by link from other computers and n8n; 127.0.0.1 = this server only
MAI_STANDALONE_HOST=0.0.0.0
MAI_STANDALONE_PORT=8000
MAI_STANDALONE_PUBLIC_URL=
MAI_DASHBOARD_URL=
# Access key: the link "mai.cmd link" carries it; n8n sends it as the X-API-Key header. Empty = no key.
MAI_API_KEY=

# --- Data
MAI_SOURCE_TIMEZONE=Europe/Moscow
# Date of the latest data in the loaded files (YYYY-MM-DD) for archive exports: the freshness,
# sample and act windows are widened from it at every start. Empty = the data are current.
MAI_STANDALONE_DATA_DATE=
MAI_DOCS_INBOX_DIR=./inbox
MAI_DOCS_STORAGE_DIR=./data/documents
MAI_DOCS_INBOX_SCAN_SECONDS=60
MAI_DOCS_WORKER=true

# --- Optional: sources the daily cycle pulls (Promine marts or other APIs): GET <URL>?well_id=<ID>
# answering with the source's .xlsx (or JSON for the crew schedule); the token is sent as
# "Authorization: Bearer". Empty = data are loaded by hand or pushed to the API. MAI_WELL_IDS: wells
# of the cycle besides those already in the database (comma separated).
# MAI_SOURCE_DARS_URL=
# MAI_SOURCE_DARS_TOKEN=
# MAI_SOURCE_KHIMIK_URL=
# MAI_SOURCE_ERA_URL=
# MAI_SOURCE_CREW_SCHEDULE_URL=
# MAI_WELL_IDS=

# --- Optional: corporate proxy for the language model (the local API is never proxied)
# HTTPS_PROXY=http://proxy.example.corp:3128
# NO_PROXY=localhost,127.0.0.1,.example.corp
