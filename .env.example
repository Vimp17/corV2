# PostgreSQL. Replace this development-only password before any shared deployment.
POSTGRES_DB=mai_corrosion
POSTGRES_USER=mai
POSTGRES_PASSWORD=change-me-before-use
MAI_DATABASE_URL=postgresql+psycopg://mai:change-me-before-use@postgres:5432/mai_corrosion

# Optional risk model artifact and extensible source mappings.
MAI_COX_MODEL_PATH=./models/cox_model.json
MAI_SOURCE_PROFILES_PATH=./config/source_profiles.json
MAI_SOURCE_TIMEZONE=Europe/Moscow
MAI_WELL_IDS=

# Data readiness and analysis thresholds.
MAI_MAX_FORWARD_FILL_DAYS=7
MAI_MAX_TELEMETRY_AGE_HOURS=48
MAI_MIN_TELEMETRY_RECORDS=8
MAI_MIN_TREND_OBSERVATIONS=8
MAI_TREND_WINDOW_DAYS=28
MAI_MIN_CURRENT_SIGNALS=2
MAI_MAX_EXCEL_BYTES=15728640
MAI_MAX_EXCEL_ROWS=10000
MAI_ALERT_RULE_CLASSES=HIGH,CRITICAL
MAI_ALERT_PROBABILITY_THRESHOLD=0.7
MAI_DASHBOARD_URL=http://localhost:8000/dashboard
# Days of full analysis history to keep (latest run per well/horizon is always kept; 0 = keep all).
MAI_ANALYSIS_RETENTION_DAYS=90
# Telemetry dated further than this into the future blocks analysis as a clock/timezone error.
MAI_MAX_FUTURE_SKEW_HOURS=24
# Scheduled monitor: parallel source refresh and retries of transient source API failures.
MAI_SOURCE_REFRESH_WORKERS=4
MAI_SOURCE_MAX_RETRIES=2

# Optional API protection. If set, configure the same value in n8n Header Auth
# credentials using header name X-API-Key. The dashboard also has a key field.
MAI_API_KEY=

# Optional LiteLLM OpenAI-compatible Chat Completions endpoint. Leave empty to disable AI reports.
MAI_LLM_API_URL=http://litellm:4000/v1/chat/completions
MAI_LLM_API_KEY=
MAI_LLM_MODEL=
MAI_LLM_TIMEOUT_SECONDS=45
MAI_LLM_MAX_RETRIES=1

# Pull mode: DARS/KHIMIK/ERA endpoints return one .xlsx file per requested well_id;
# crew schedule returns JSON. For source JSON APIs use a SourceAdapter or push endpoints.
MAI_SOURCE_DARS_URL=
MAI_SOURCE_DARS_TOKEN=
MAI_SOURCE_KHIMIK_URL=
MAI_SOURCE_KHIMIK_TOKEN=
MAI_SOURCE_ERA_URL=
MAI_SOURCE_ERA_TOKEN=
MAI_SOURCE_CREW_SCHEDULE_URL=
MAI_SOURCE_CREW_SCHEDULE_TOKEN=

# n8n
N8N_VERSION=2.40.7
N8N_BIND_ADDRESS=127.0.0.1
N8N_HOST_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow
